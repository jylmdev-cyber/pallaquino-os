      "npm",
      "test"
    ],
    [
      "npm",
      "run",
      "test"
    ],
    [
      "dotnet",
      "test"
    ],
    [
      "go",
      "test"
    ],
    [
      "php",
      "artisan",
      "test"
    ]
  ]
}

{
  "name": "pallaquino-academy",
  "version": "0.1.0",
  "private": true,
  "description": "PALLAQUINO Interactive Learning Academy: static learning portal for PALLAQUINO Autonomous Engineering OS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "python scripts/generate_data.py",
    "data:check": "python scripts/generate_data.py --check",
    "transcripts": "python scripts/capture_transcripts.py",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:a11y": "node scripts/validate-a11y.mjs",
    "validate": "npm run validate:content && npm run validate:links && npm run validate:a11y",
    "ci": "npm run data:check && npm run check && npm run test && npm run validate:content && npm run build && npm run validate:links && npm run validate:a11y"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/vue": "7.0.3",
    "astro": "7.3.8",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
